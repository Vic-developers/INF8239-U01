# ─────────────────────────────────────────────────────────────────────────────
# Moodle Control Center — development environment
# Copy to .env and adjust. NEVER commit a filled-in copy.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# ── Database ────────────────────────────────────────────────────────────────
# Migrations run as mcc_owner (owns schemas); the runtime role is mcc_app and
# must not have BYPASSRLS, otherwise tenant isolation is void.
#
# POSTGRES_PORT is 5434 rather than the usual 5432 because this machine already
# has a native PostgreSQL service bound to 5432, which shadows the published
# Docker port. Change both together if 5434 is taken.
POSTGRES_DB=moodle_control_center
POSTGRES_USER=mcc
POSTGRES_PASSWORD=mcc_local_dev_password
POSTGRES_PORT=5434

# Request-serving role. Scoped to one tenant per transaction by RLS.
DATABASE_URL=postgresql://mcc_app:mcc_app_local@localhost:5434/moodle_control_center
# Schema owner. Runs migrations only; never used by application code paths.
DATABASE_MIGRATION_URL=postgresql://mcc_owner:mcc_owner_local@localhost:5434/moodle_control_center
# The single BYPASSRLS role: tenant provisioning, login-time identity lookup and
# cross-tenant jobs. Never injected into a request handler.
DATABASE_PLATFORM_URL=postgresql://mcc_platform:mcc_platform_local@localhost:5434/moodle_control_center
DATABASE_POOL_MAX=10

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
REDIS_MAXMEMORY=256mb

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_REFRESH_PEPPER=
SESSION_IDLE_TIMEOUT=30m

# ── Encryption ──────────────────────────────────────────────────────────────
# Base64 32-byte master key. Wraps per-record DEKs for Moodle credentials.
# Generate with: openssl rand -base64 32
# Rotating this requires re-wrapping DEKs; key_version supports online rotation.
MCC_MASTER_KEY=
MCC_MASTER_KEY_VERSION=1

# ── Moodle integration ──────────────────────────────────────────────────────
# Use 'mock' to develop without a real Moodle. See packages/shared mock data.
MCC_MOODLE_ADAPTER=mock
MOODLE_DEFAULT_RATE_PROFILE=default
MOODLE_CONNECT_TIMEOUT_MS=10000
MOODLE_REQUEST_TIMEOUT_MS=30000
# Allow non-HTTPS Moodle URLs. Never enable in production.
MOODLE_ALLOW_INSECURE_URL=false

# ── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173

# ── Mail (Mailpit in development) ───────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@moodle-control-center.local

# ── Web ─────────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3000/api/v1
WEB_PORT=5173

# ── Observability ───────────────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_PRETTY=true
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
METRICS_ENABLED=true

# ── Rate limits (global, per IP) ────────────────────────────────────────────
RATE_LIMIT_AUTH_PER_MINUTE=5
RATE_LIMIT_API_PER_MINUTE=300

# ── Feature flags ───────────────────────────────────────────────────────────
FEATURE_AI_COPILOT=false
FEATURE_MFA=false
FEATURE_SSO=false