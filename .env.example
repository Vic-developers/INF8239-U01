# Moodle Control Center — environment template
#
# Copy to `.env` and fill in the secrets. NEVER commit a filled-in copy.
# Every variable here is validated at startup by apps/api/src/config/configuration.ts;
# a missing or malformed value stops the process before it serves traffic.

NODE_ENV=development

# ── Server ───────────────────────────────────────────────────────────
PORT=3001
HOST=127.0.0.1
# Comma-separated allowed origins, or `*` in development only.
CORS_ORIGINS=http://localhost:5173
# Set to true ONLY when behind a reverse proxy. Without a proxy it
# makes every request appear to come from the proxy, breaking per-IP
# rate limiting.
TRUST_PROXY=false

# ── Database ─────────────────────────────────────────────────────────
# Four roles, on purpose:
#   mcc_owner      owns the schemas; runs migrations; never serves requests
#   mcc_app        serves requests; NOBYPASSRLS; one tenant per transaction
#   mcc_platform   the single BYPASSRLS role: tenant provisioning, login
#                  identity lookup, cross-tenant jobs
#   mcc_ro         read-only BI access
POSTGRES_DB=moodle_control_center
POSTGRES_USER=mcc
POSTGRES_PASSWORD=change-me-in-production
# 5434 rather than 5432: this machine often already runs a PostgreSQL on
# 5432, which would shadow the published Docker port.
POSTGRES_PORT=5434

DATABASE_URL=postgresql://mcc_app:mcc_app_local@127.0.0.1:5434/moodle_control_center
DATABASE_MIGRATION_URL=postgresql://mcc_owner:mcc_owner_local@127.0.0.1:5434/moodle_control_center
DATABASE_PLATFORM_URL=postgresql://mcc_platform:mcc_platform_local@127.0.0.1:5434/moodle_control_center
DATABASE_POOL_MAX=10

# ── Redis / queues ───────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379
# Worker concurrency; also the cap on simultaneous Moodle calls.
WORKER_CONCURRENCY=4

# ── Auth ─────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
ACCESS_TOKEN_SECRET=replace-with-openssl-rand-base64-48
# Pepper mixed into refresh-token hashes: a database leak alone is not
# enough to use a stolen refresh token.
# Generate with: openssl rand -base64 32
REFRESH_TOKEN_PEPPER=replace-with-openssl-rand-base64-32
ACCESS_TOKEN_TTL_SECONDS=900
# Absolute session lifetime; refresh cannot extend past it.
SESSION_TTL_SECONDS=2592000
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
COOKIE_SECURE=false
# COOKIE_DOMAIN=.example.com

# ── Encryption ───────────────────────────────────────────────────────
# Base64 32-byte AES-256 key. Wraps per-record data keys for Moodle
# tokens. Generate with: openssl rand -base64 32
# Rotating it re-wraps data keys in the background; key_version tracks it.
MCC_MASTER_KEY=replace-with-openssl-rand-base64-32
MCC_MASTER_KEY_VERSION=1

# ── Moodle integration ───────────────────────────────────────────────
# Outbound HTTP timeout toward a Moodle instance, in milliseconds.
MOODLE_TIMEOUT_MS=30000
MOODLE_RATE_LIMIT_PROFILE=default
# Allow the mock adapter. Must be false in production: a mock that looks
# real is how an institution discovers its enrolment data was never written.
ALLOW_MOCK_MOODLE=true

# ── Logging ──────────────────────────────────────────────────────────
LOG_LEVEL=info
