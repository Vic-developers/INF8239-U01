# Normalize line endings for text files
* text=auto

*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.sql text eol=lf
*.prisma text eol=lf
*.php text eol=lf
*.xml text eol=lf
*.sh text eol=lf
Dockerfile text eol=lf
*.conf text eol=lf

